# Configuración para servidores Apache (hosting tradicional)
# Si usás Netlify, Vercel o GitHub Pages, este archivo no hace falta.

# Página 404 personalizada
ErrorDocument 404 /404.html

# Compresión de archivos de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache de imágenes un mes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Encabezados de seguridad básicos
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Idioma por defecto (Español - Argentina)
DefaultLanguage es-AR

# Servir UTF-8 para contenido de texto
AddDefaultCharset UTF-8